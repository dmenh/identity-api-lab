# Run scripts/install.ps1 or scripts/install.sh to generate .env securely.
APP_PORT=8787
GRPC_PORT=50051
APP_BIND=127.0.0.1
LAB_DATABASE=postgres
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
ADMIN_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DEMO_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
SERVER_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_HEX
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOW_PRIVATE_SSO=false
ALLOW_INSECURE_SSO=false
ALLOW_PRIVATE_SFTP=false
GRPC_ENABLED=true
